---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { Icon } from "astro-icon/components";
import PageTitle from "../../components/PageTitle.astro";
import Callout from "../../components/Callout.astro";
import MaizeButton from "../../components/MaizeButton.astro";
import { careersFeedQuery } from "../../lib/api.js";
import ogImage from '/public/social/faculty-jobs.jpg';

const careersSearchUrl = "https://careers.umich.edu/browse-jobs/departments/210308";

interface JobOpening {
  title: string;
  link: string;
  pubDate: string;
}

const openings: JobOpening[] = await careersFeedQuery();

function formatPostedDate(pubDate: string) {
  const date = new Date(pubDate);
  if (isNaN(date.getTime())) return null;
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<MainLayout title="Jobs | Michigan Robotics" description="Join Michigan Robotics as faculty or staff and work together to create smart machines and serve society." image={ogImage.src}>
  <Breadcrumbs slot="breadcrumbs" />
  <PageTitle title="Jobs" />

    <div class="prose dark:prose-invert mt-8 mb-4 max-w-6xl w-11/12 mx-auto">
      <p class="text-3xl font-semibold text-arboretumBlue dark:text-maize mb-4">Work together. Create smart machines. Serve society.</p>

      <p>We invite applicants to join our mission to accelerate advances in robotics for the benefit of society.</p>


      <h2 class="text-3xl font-roboto-condensed font-bold mb-4 text-umichblue dark:text-neutral-50">About Michigan Robotics</h2>

      <p>The University of Michigan Robotics Department creates the next generation of robotics and roboticists for the benefit of society. Operating out of the new world-class Ford Motor Company Robotics Building, the Department is one of the first free-standing robotics departments among leading engineering schools. Growing out of a successful Robotics Institute, the Department was established in 2022 to offer Bachelor's degrees in addition to Masters and PhDs degrees (since 2014), with the goal of defining the discipline of Robotics.</p>
      
      <p>Michigan Robotics pursues fundamental research across core areas of sensing, reasoning, acting, and interacting with humans. Roboticists from the Department join colleagues across the College of Engineering, Medical School, School of Information, School of Kinesiology, College of Architecture & Urban Planning, and School of Art & Design to work on robot learning and foundational models, perception and computer vision, manipulation and grasping, and motion planning and control. Faculty also study human-robot interaction and teaming, the design and soft robotics that give machines their physical form, and the safe autonomy that keeps these systems reliable in the real world. Michigan Robotics comprises 24 tenured and tenure-track faculty members, with more than 180 undergraduate students and over 250 graduate students, and is supported by an annual research budget of approximately $15 million dollars (FY2026).</p>
        
        <p>Our department is distinguished by its core values: robotics with respect, enthusiasm for outreach, and integrity in action. We ensure our designs and robots treat human interactions respectfully, inspire future students through outreach to change the world, and report both our successes and failures to show true progress in the field.</p>

            <p>The University of Michigan is one of the world’s leading research universities, with $2.16B in research expenditures (2025). Consistently ranked among the top research universities by USNews and NSF, it has 19 schools and colleges, the University is rich with opportunities for collaboration and cross-disciplinary inquiry. We are located in Ann Arbor, MI, which is ranked the #1 Best Small College Town in America by WalletHub (2025), #2 City with the Best Public Schools in America by Niche.com (2021), and #1 Best Places to Live for Families by Fortune (2022).</p>

      <div class="not-prose grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">

        <a href="https://robotics.umich.edu/about/values/" class="no-underline group card-base surface card-padded card-hover surface-border">
          <h3 class="text-lg font-bold text-umichblue dark:text-neutral-50 mb-2 decoration-maize decoration-2 group-hover:underline underline-offset-4">Our Values</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm">Learn more about Michigan Robotics' commitment to integrity, enthusiasm, respect, and our shared principles that guide our community.</p>
          <div class="flex items-center text-arboretumBlue dark:text-maize mt-2 group-hover:translate-x-2 transition-transform">
            <span>Read more</span>
            <Icon name="mdi:arrow-right" class="ml-1 w-4 h-4" />
          </div>
        </a>
        <a href="https://umich.edu/facts-figures/" class="no-underline group card-base surface card-padded card-hover surface-border">
          <h3 class="text-lg font-bold text-umichblue dark:text-neutral-50 mb-2 decoration-maize decoration-2 group-hover:underline underline-offset-4">U-M Facts</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm">Explore key statistics and data about the University of Michigan's research impact, student body, faculty achievements, and more.</p>
          <div class="flex items-center text-arboretumBlue dark:text-maize mt-2 group-hover:translate-x-2 transition-transform">
            <span>Learn more</span>
            <Icon name="mdi:open-in-new" class="ml-1 w-4 h-4" />
          </div>
        </a>
        <a href="https://michiganross.umich.edu/about/visit/ann-arbor" class="no-underline group card-base surface card-padded card-hover surface-border">
          <h3 class="text-lg font-bold text-umichblue dark:text-neutral-50 mb-2 decoration-maize decoration-2 group-hover:underline underline-offset-4">Living in Ann Arbor</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm">Discover what makes Ann Arbor one of the best college towns in America, from its vibrant downtown to its excellent schools and high quality of life.</p>
          <div class="flex items-center text-arboretumBlue dark:text-maize mt-2 group-hover:translate-x-2 transition-transform">
            <span>Learn more</span>
            <Icon name="mdi:open-in-new" class="ml-1 w-4 h-4" />
          </div>
        </a>
      </div>

      <h2 class="text-3xl font-roboto-condensed font-bold mb-4 text-umichblue dark:text-neutral-50">Current openings</h2>

      <p>Faculty and staff positions in the Robotics Department are posted on the <a href={careersSearchUrl}>University of Michigan careers site</a>.</p>

      <div class="card-base surface card-padded surface-border">
        <h3 class="text-3xl font-roboto-condensed font-bold mb-4 text-umichblue dark:text-neutral-50">Robotics Department Chair</h3>

        <div class="prose dark:prose-invert max-w-none">
          <p>The Robotics Department at the University of Michigan, Ann Arbor invites applications and nominations for the position of Department Chair. The Chair will provide visionary leadership for one of the first free-standing robotics departments among leading engineering schools, guiding its continued growth in research, education, and community impact.</p>

          <p>The successful candidate for Department Chair will be a leading world-class scholar with a distinguished track record in robotics and related disciplines. The candidate should not only possess an exemplary record of achievement in research, teaching, leadership, and service at a level commensurate with the appointment as a tenured full professor, but also command a vision for the future of the Robotics discipline. This vision should leverage and build on the strengths of our existing department and programs at the University of Michigan, leading them into an increasingly commanding position in the multidisciplinary field of Robotics.</p>

          <p>Key attributes of successful candidates include:</p>
          <ul>
            <li>Demonstrated leadership experience at the candidate's home institution as well as nationally and internationally.</li>
            <li>Proven communication, management, and interpersonal skills.</li>
            <li>A strong research track record demonstrated through publications, national and international collaborations, grants, and fundraising.</li>
            <li>Demonstrated excellence in teaching and curriculum development in Robotics.</li>
            <li>Significant experience in bridging from the academic lab to serving society.</li>
            <li>A Ph.D. in robotics, computer science, or other engineering discipline.</li>
          </ul>

          <p>Applications are due <strong>November 15, 2026</strong>.</p>
          <MaizeButton href="https://apply.interfolio.com/190127" text="See full posting and apply" external={true} />
        </div>
      </div>

      <div class="card-base surface card-padded surface-border mt-8">
        <h3 class="text-3xl font-roboto-condensed font-bold mb-4 text-umichblue dark:text-neutral-50">Tenure-track faculty</h3>

        <div class="prose dark:prose-invert max-w-none">
          <p>The Robotics Department in the College of Engineering at the University of Michigan, Ann Arbor invites applications for faculty that will join our mission to accelerate advances in robotics for the benefit of society. Successful candidates will have a relevant doctorate or equivalent experience and an outstanding record of achievement and impactful research in academia, industry, and/or at national laboratories. They will have a strong record of commitment to teaching at the undergraduate and graduate levels and to providing service to the university and to the profession.</p>

          <Callout type="info">
            <p>Please check back soon for future calls to apply.</p>
          </Callout>

          <p>Employment will require a criminal background check and may require an institutional reference check regarding any misconduct. If an institutional reference check is necessary, candidates will be required to submit a self-disclosure form as well as an authorization to release information form.</p>

          <p>The University of Michigan is responsive to the needs of dual-career families. We are a non-discriminatory, affirmative-action employer.</p>

          <h4 class="text-xl font-bold mt-6 mb-2">Questions</h4>
          <p>For faculty hiring, please <a href="mailto:robotics-faculty-search@umich.edu">contact the faculty search committee</a>. For all other questions, please <a href="mailto:robotics-contact@umich.edu">contact us</a>.</p>
        </div>
      </div>

      <div class="mt-8">
      {openings.length > 0 ? (
        <ul class="not-prose list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          {openings.map(opening => (
            <li>
              <a href={opening.link} class="no-underline group card-base surface card-padded card-hover surface-border block h-full">
                <h3 class="text-lg font-bold text-umichblue dark:text-neutral-50 mb-2 decoration-maize decoration-2 group-hover:underline underline-offset-4">{opening.title}</h3>
                {formatPostedDate(opening.pubDate) && (
                  <p class="text-gray-600 dark:text-gray-300 text-sm">Posted {formatPostedDate(opening.pubDate)}</p>
                )}
                <div class="flex items-center text-arboretumBlue dark:text-maize mt-2">
                  <span>View posting and apply</span>
                  <Icon name="mdi:open-in-new" class="ml-1 w-4 h-4" />
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <Callout type="info">
          <p>There are currently no listed open staff positions for the Robotics Department at the <a href={careersSearchUrl}>U-M careers site</a>.</p>
        </Callout>
      )}
      </div>

      <h3 class="text-xl font-bold mt-8 mb-2 text-umichblue dark:text-neutral-50">U-M EEO statement</h3>
      <p>The University of Michigan is an Equal Opportunity Employer. We are committed to providing an environment of mutual respect where equal employment opportunities are available to all applicants, including protected veterans and individuals with disabilities.</p>
    </div>
</MainLayout>
